# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
.nebius/
# Nebius account IDs (project, network, subnet), loaded by cloud/nebius/lib.sh
/cloud/nebius/*.local.env

# --- Working notes and the build log: kept locally, not published ---
/CLAUDE.md
/MEMORY.md
/RESOURCES.md
/docs/
/steps/
/nvidia-track/
# the course plan documents (layout.json and inventory.json stay: the code reads them)
/pipeline/01-plan/*.md
/pipeline/01-plan/concept/
/pipeline/handoff/
# design notes and the as-run record (scripts as first sent, failures included): for learning, not needed to build
/assets/*/NOTES.md
/pipeline/02-course-preview/NOTES.md
**/build/as-run/
# terminal logs of each VM session (IP addresses, timings, local paths)
/cloud/nebius/as-run/

# --- Third-party checkouts (pinned; re-created by hand, see tooling/README.md) ---
/tools/freecad-mcp/

# --- NVIDIA video frames: private design reference, not redistributed ---
/pipeline/01-plan/video-reference/

# --- Recordings and renders (large; regenerated by the scripts) ---
/videos/
/eval/videos/
/pipeline/02-course-preview/renders/
/showreel/build/

# --- 3D authoring files and exports, rebuilt by assets/<id>/build/build.sh ---
# (model.usd, its textures and the preview images stay: the scene and the stream read them)
*.blend
*.blend1
*.blend2
*.FCStd
*.FCStd1
*.FCBak
*.step
*.stl
*.glb
# pictures: previews, reference images and the shared material
# textures, which their seeded scripts in assets/_materials/ regenerate
/assets/*/preview*.png
/assets/*/reference.png
/assets/_materials/**/*.png

# --- Training and evaluation outputs (large; kept on the GPU machine or local only) ---
/training/runs/**
# ...except the scripts that produced each run (small, needed to reproduce it)
!/training/runs/**/
!/training/runs/**/*.sh
/training/logs/
logs/
outputs/
wandb/
*.pt
*.pth
*.ckpt
*.onnx
*.mp4
*.mov
*.webm
*.gif
*.zip
*.tar
*.tar.gz

# --- Python / tooling ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- OS / editors ---
.DS_Store
.idea/
.vscode/
*.swp
