# Nebius workstation, eu-south1 (default: closer to the Mac, so less stream lag; same RTX PRO 6000 price). Account IDs go in workstation.eu-south1.local.env (git-ignored).
PROJECT=                                  # your project-… id: set it in workstation.eu-south1.local.env
NETWORK=                                  # your vpcnetwork-… id: set it in workstation.eu-south1.local.env
SUBNET=                                   # your vpcsubnet-… id: set it in workstation.eu-south1.local.env
PLATFORM=gpu-rtx6000-a                          # NVIDIA RTX PRO 6000 Blackwell, $1.80/GPU-h on-demand
PRESET=1gpu-24vcpu-218gb
IMAGE_FAMILY=ubuntu24.04-cuda13-latest          # latest driver; Isaac Lab asks for >= 595.58.03
IMAGE_PARENT=project-e07public-images           # public images live here, not in our project
DISK_NAME=isaac-ws-boot
DISK_GIB=250                                    # network_ssd $0.071/GiB-month -> ~$17.75/month while it exists
SG_NAME=isaac-ws-sg
VM_NAME=isaac-ws
VM_USER=duck
SSH_KEY=~/.ssh/id_ed25519
# ports the Mac may reach (TCP): SSH, Isaac Sim WebRTC signalling and fallback; (UDP): WebRTC media
TCP_PORTS="22 49100 48010"
UDP_PORTS="47998"
